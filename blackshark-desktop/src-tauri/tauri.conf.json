{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackShark Battery",
  "version": "0.1.0",
  "identifier": "com.axthrowa.blackshark-battery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlackShark Battery",
        "width": 440,
        "height": 620,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true,
        "skipTaskbar": false,
        "backgroundColor": "#08090B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
