{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Battery Hub",
  "version": "0.2.0",
  "identifier": "com.axthrowa.battery-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Battery Hub",
        "width": 520,
        "height": 720,
        "minWidth": 440,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true,
        "skipTaskbar": false,
        "backgroundColor": "#08090B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Axthrowa",
    "copyright": "Copyright © Axthrowa",
    "category": "Utility",
    "shortDescription": "Multi-brand wireless battery hub",
    "longDescription": "Tray battery hub for Razer, Logitech (HID++), Ajazz and Soundcore devices. Destroys WebView2 when closed to keep RAM near zero.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
